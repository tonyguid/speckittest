    "2895": {
      "id": 2895,
      "type": "User Story",
      "title": "Copy Blob with Progress Tracking",
      "state": "New",
      "description": "A user needs to copy a blob from one Azure Blob Storage location to another. They provide the source blob URI and destination blob URI through the user interface, and the system initiates the copy operation while displaying real-time progress updates.",
